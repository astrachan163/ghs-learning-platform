{
  "name": "ghs-learning-platform",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "lint": "echo \"(Add lint step)\"",
    "manifest:generate": "bash scripts/generate-release-manifest.sh",
    "security:scan": "npm audit --workspace backend || true",
    "sbom": "npx @cyclonedx/cyclonedx-npm --output-file sbom.json",
    "test": "npm test --workspaces --if-present",
    "check": "node scripts/check-claims.mjs && node scripts/check-emoji.mjs && node scripts/check-brand-hotlink.mjs"
  }
}