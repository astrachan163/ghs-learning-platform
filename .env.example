# Copy this file to .env.local in the repository root.
# Fill in your own values. Never commit .env.local.

# Firebase Admin service account, as one JSON object on a single line.
# The API reads this at startup (skipped when NODE_ENV=test).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Listed by backend/src/config/secrets.ts. The server does not call that loader yet.
FIREBASE_API_KEY=

# Listed by backend/src/config/secrets.ts. The server does not call that loader yet.
GOOGLE_OAUTH_CLIENT_ID=

# API port. The server uses 4000 when this is unset.
PORT=4000
